package com.segurax;

import io.cucumber.junit.CucumberOptions;
import net.serenitybdd.cucumber.CucumberSerenityRunner;
import org.junit.runner.RunWith;

/**
 * Cucumber Test Suite for SeguraX E2E Tests
 * Generated from ASDD QA Phase
 * 
 * This runner executes all feature files in src/test/resources/features/
 * using the Serenity BDD framework with Screenplay Pattern.
 */
@RunWith(CucumberSerenityRunner.class)
@CucumberOptions(
    plugin = {
        "pretty",
        "html:target/cucumber-reports/cucumber-html-report.html",
        "json:target/cucumber-reports/cucumber.json"
    },
    features = "src/test/resources/features/",
    glue = {
        "com.segurax.stepdefinitions",
        "com.segurax.hooks"
    },
    tags = "not @wip and not @manual",
    monochrome = true,
    dryRun = false,
    strict = true
)
public class CucumberTestSuite {
    // This class serves as the test runner
    // All configuration is done via annotations above
}
