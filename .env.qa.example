# ============================================================
# Variables de entorno — Entorno QA / Pre-Producción
# ============================================================
# Uso: docker compose -f docker-compose.qa.yml --env-file .env.qa up -d --build
#
# NUNCA commitear este archivo con valores reales.
# Agregar .env.qa al .gitignore.
# ============================================================

# ─── Gateway / CORS ────────────────────────────────────────
# Sin auth en QA → '*' permite cualquier origen
# Si querés restringir a la IP de la EC2:
# FRONTEND_ORIGIN=http://TU-IP-EC2:8080
FRONTEND_ORIGIN=*

# ─── Supabase — Conexión a la base de datos ────────────────
# Encontrás estos valores en:
# Supabase Dashboard → Project Settings → Database → Connection Info
#
# OPCIÓN A: Direct connection (puerto 5432)
# Usar cuando los servicios corren en el mismo servidor (EC2 en la misma región)
DB_HOST=db.XXXXXXXXXXXXXXXXXXXX.supabase.co
DB_PORT=5432

# OPCIÓN B: Transaction Pooler (puerto 6543) — recomendado para producción
# Usar cuando hay múltiples instancias o serverless
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543

# Supabase Dashboard → Project Settings → Database → Database password
DB_USERNAME=postgres
DB_PASSWORD=PEGAR_PASSWORD_DE_SUPABASE_AQUI

# ─── Schemas separados ────────────────────────────────────
# ms-core utiliza este schema
DB_NAME_CORE=postgres

# ms-catalogos utiliza este schema (debe existir en Supabase)
# Crearlo en Supabase: Dashboard → SQL Editor → CREATE SCHEMA catalogos;
DB_NAME_CATALOGOS=postgres
# NOTA: En Supabase ambos usan la misma DB "postgres" pero schemas distintos.
# El schema se configura en el TypeORM de cada servicio con la opción "schema".
# Ver sección "Schemas en Supabase" más abajo.
